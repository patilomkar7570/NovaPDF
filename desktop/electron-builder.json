{
  "appId": "app.novapdf.desktop",
  "productName": "NOVA PDF",
  "copyright": "Copyright © 2026 patilomkar7570",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "resources/icon.ico",
    "forceCodeSigning": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NOVA PDF",
    "installerIcon": "resources/icon.ico",
    "uninstallerIcon": "resources/icon.ico",
    "artifactName": "NOVA-PDF-Windows-Setup-v${version}.${ext}"
  }
}
